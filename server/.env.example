PORT=5000
JWT_SECRET=your_jwt_secret_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin Initial Seed Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production Frontend CORS Client Origin (e.g. https://fictionfigure.vercel.app)
CLIENT_ORIGIN=

# Public Backend HTTPS API Base URL for file upload URLs (e.g. https://fictionfigure.onrender.com)
PUBLIC_API_URL=

# Cloudinary Permanent Image Storage Configuration (Render Production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

